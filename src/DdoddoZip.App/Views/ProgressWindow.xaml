<Window x:Class="DdoddoZip.App.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="460" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" ProgressState="Normal" />
    </Window.TaskbarItemInfo>
    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="CurrentItem" Text="준비 중…" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="Bar" Height="6" Margin="0,10,0,8" Maximum="1000"
                     Foreground="{StaticResource Accent}" Background="#E3E7EB" BorderThickness="0" />
        <Grid>
            <TextBlock x:Name="SizeText" Style="{StaticResource SubText}" HorizontalAlignment="Left" />
            <TextBlock x:Name="SpeedText" Style="{StaticResource SubText}" HorizontalAlignment="Right" />
        </Grid>
        <Button x:Name="CancelButton" Content="취소" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Cancel_Click" />
    </StackPanel>
</Window>
