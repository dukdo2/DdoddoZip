<Window x:Class="DdoddoZip.App.Views.CompressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="압축하기" Width="520">
    <StackPanel Margin="20,16">
        <TextBlock Text="압축 파일 이름" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" />
            <TextBlock x:Name="ExtText" Grid.Column="1" Text=".zip" Style="{StaticResource SubText}" FontSize="13"
                       VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="52" />
        </Grid>

        <TextBlock Text="저장 위치" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" />
            <Button Grid.Column="1" Content="찾아보기…" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <TextBlock Text="형식" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <Border Style="{StaticResource SegmentBox}">
            <UniformGrid Rows="1" x:Name="FormatGroup">
                <RadioButton Style="{StaticResource Segment}" GroupName="fmt" Content="ZIP" Tag="Zip" Checked="Format_Checked" />
                <RadioButton Style="{StaticResource Segment}" GroupName="fmt" Content="7Z" Tag="SevenZip" Checked="Format_Checked" />
                <RadioButton Style="{StaticResource Segment}" GroupName="fmt" Content="TAR" Tag="Tar" Checked="Format_Checked" />
                <RadioButton Style="{StaticResource Segment}" GroupName="fmt" Content="TAR.GZ" Tag="TarGz" Checked="Format_Checked" />
                <RadioButton Style="{StaticResource Segment}" GroupName="fmt" Content="TAR.XZ" Tag="TarXz" Checked="Format_Checked" />
                <RadioButton Style="{StaticResource Segment}" GroupName="fmt" Content="TAR.BZ2" Tag="TarBz2" Checked="Format_Checked" />
            </UniformGrid>
        </Border>

        <TextBlock x:Name="LevelLabel" Text="압축 수준" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <Border x:Name="LevelBox" Style="{StaticResource SegmentBox}">
            <UniformGrid Rows="1" x:Name="LevelGroup">
                <RadioButton Style="{StaticResource Segment}" GroupName="lvl" Content="저장만" Tag="Store" />
                <RadioButton Style="{StaticResource Segment}" GroupName="lvl" Content="빠름" Tag="Fast" />
                <RadioButton Style="{StaticResource Segment}" GroupName="lvl" Content="보통" Tag="Normal" />
                <RadioButton Style="{StaticResource Segment}" GroupName="lvl" Content="최고" Tag="Maximum" />
            </UniformGrid>
        </Border>

        <Border Style="{StaticResource Note}" Margin="0,14,0,0">
            <TextBlock x:Name="SummaryText" Style="{StaticResource SubText}" Text="담길 파일을 세는 중…" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="압축" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
            <Button Content="취소" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
