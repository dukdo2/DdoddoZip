<Window x:Class="DdoddoZip.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Width="440" Title="또또집 정보">
    <StackPanel Margin="20,16">
        <!-- head -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="pack://application:,,,/Assets/app-source.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="또또집" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource SubText}" FontSize="13" />
            </StackPanel>
        </StackPanel>

        <!-- update -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="업데이트" Style="{StaticResource SubText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DockPanel>
                    <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="업데이트 확인" Click="UpdateButton_Click" />
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{StaticResource Sub}" VerticalAlignment="Center" />
                        <Button x:Name="NotesLink" Style="{StaticResource TextLink}" Content="바뀐 점" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="Collapsed" Click="NotesLink_Click" />
                    </WrapPanel>
                </DockPanel>
                <CheckBox x:Name="AutoCheck" Content="자동으로 업데이트 확인 (하루 한 번)" Margin="0,8,0,0" Click="AutoCheck_Click" />
            </StackPanel>
        </Border>

        <!-- donation -->
        <Border x:Name="SupportBox" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="후원" Style="{StaticResource SubText}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="도움이 되셨다면 후원으로 응원해 주세요." TextWrapping="Wrap" />
                <UniformGrid x:Name="SupportButtons" Rows="1" Margin="0,10,0,0">
                    <Button x:Name="KakaoButton" Content="카카오페이로 후원" Background="#FEE500" BorderBrush="#FEE500" Foreground="#191919"
                            FontWeight="SemiBold" Margin="0,0,4,0" Click="Kakao_Click" />
                    <Button x:Name="SponsorsButton" Margin="4,0,0,0" Click="Sponsors_Click">
                        <TextBlock><Run Text="♥" Foreground="#E0457B" /><Run Text=" GitHub Sponsors" /></TextBlock>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- links -->
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="닫기" IsCancel="True" IsDefault="True" Click="Close_Click" />
            <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource TextLink}" Content="GitHub 저장소" Click="Repo_Click" Margin="0,0,12,0" />
                <Button Style="{StaticResource TextLink}" Content="라이선스" Click="License_Click" Margin="0,0,12,0" />
                <Button Style="{StaticResource TextLink}" Content="문제 신고 (메일)" Click="Report_Click" />
            </WrapPanel>
        </DockPanel>
    </StackPanel>
</Window>
