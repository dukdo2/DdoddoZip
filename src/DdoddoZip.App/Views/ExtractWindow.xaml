<Window x:Class="DdoddoZip.App.Views.ExtractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="풀기" Width="520">
    <StackPanel Margin="20,16">
        <TextBlock Text="풀 위치" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" />
            <Button Grid.Column="1" Content="찾아보기…" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <CheckBox x:Name="MakeFolder" Margin="0,10,0,2" />
        <CheckBox x:Name="OpenAfter" Content="다 풀고 폴더 열기" />

        <TextBlock Text="같은 이름 파일이 있으면" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <Border Style="{StaticResource SegmentBox}">
            <UniformGrid Rows="1" x:Name="OverwriteGroup">
                <RadioButton Style="{StaticResource Segment}" GroupName="ow" Content="물어보기" Tag="Ask" IsChecked="True" />
                <RadioButton Style="{StaticResource Segment}" GroupName="ow" Content="덮어쓰기" Tag="Overwrite" />
                <RadioButton Style="{StaticResource Segment}" GroupName="ow" Content="건너뛰기" Tag="Skip" />
                <RadioButton Style="{StaticResource Segment}" GroupName="ow" Content="이름 바꾸기" Tag="Rename" />
            </UniformGrid>
        </Border>

        <Border Style="{StaticResource Note}" Margin="0,14,0,0">
            <TextBlock x:Name="SummaryText" Style="{StaticResource SubText}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="풀기" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
            <Button Content="취소" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
