<Window x:Class="DdoddoZip.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="암호 입력" Width="420">
    <StackPanel Margin="20,16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
            <Run x:Name="FileName" FontWeight="SemiBold" /><Run Text="은(는) 암호가 걸려 있습니다." />
        </TextBlock>
        <Grid>
            <PasswordBox x:Name="Hidden" PasswordChanged="Hidden_Changed" Padding="6,4,36,4" />
            <TextBox x:Name="Visible" Visibility="Collapsed" TextChanged="Visible_Changed" Padding="6,4,36,4" />
            <ToggleButton x:Name="ShowToggle" HorizontalAlignment="Right" Width="32" Margin="0,1,1,1" Cursor="Hand"
                          Background="Transparent" BorderThickness="0" Checked="Show_Changed" Unchecked="Show_Changed"
                          ToolTip="암호 보기" Content="👁" />
        </Grid>
        <TextBlock x:Name="WrongText" Text="암호가 맞지 않습니다. 다시 입력해 주세요." Foreground="{StaticResource Danger}"
                   FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="확인" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
            <Button Content="취소" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
